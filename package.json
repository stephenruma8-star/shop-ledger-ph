{
    "name": "shop-ledger-ph",
    "version": "3.9.6",
    "description": "Shop Ledger PH - Complete POS & Inventory System for Philippine Sari-Sari Stores",
    "repository": "stephenruma8-star/shop-ledger-ph",
    "main": "out/main/index.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "build:win": "electron-vite build && electron-builder --win",
        "preview": "electron-vite preview",
        "rebuild:electron": "node scripts/rebuild-electron-abi.mjs",
        "lint": "node scripts/lint.mjs && eslint . && npm run typecheck",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run lint && npm run build && node scripts/smoke.mjs && node scripts/smoke-validation.mjs && node scripts/smoke-mobile.mjs && node scripts/smoke-mobilepage.mjs && node scripts/smoke-strict-idb.mjs && node scripts/smoke-quicksale.mjs && node scripts/smoke-onboarding.mjs && node scripts/sqlite-node-abi.mjs && node scripts/smoke-sqlite.mjs && node scripts/smoke-backups.mjs && node scripts/smoke-lan-api.mjs && node scripts/smoke-logger.mjs"
    },
    "dependencies": {
        "axios": "^1.18.1",
        "better-sqlite3": "^12.11.1",
        "cors": "^2.8.6",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.9",
        "express": "^4.22.2",
        "nodemailer": "^9.0.5",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.2.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.2.0",
        "electron": "^42.9.3",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^10.8.1",
        "globals": "^17.11.0",
        "typescript": "^7.0.2"
    },
    "build": {
        "appId": "com.shopledger.ph",
        "productName": "Shop Ledger PH",
        "files": [
            "out/**"
        ],
        "asarUnpack": [
            "**/node_modules/better-sqlite3/**"
        ],
        "directories": {
            "output": "build"
        },
        "icon": "src/renderer/assets/icon.png",
        "win": {
            "icon": "src/renderer/assets/icon.ico",
            "requestedExecutionLevel": "requireAdministrator",
            "target": [
                "nsis",
                "portable"
            ]
        },
        "portable": {
            "artifactName": "Shop-Ledger-PH-${version}-portable.exe"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "stephenruma8-star",
                "repo": "shop-ledger-ph"
            }
        ],
        "npmRebuild": false,
        "nsis": {
            "oneClick": true,
            "createDesktopShortcut": true,
            "perMachine": false,
            "installerIcon": "src/renderer/assets/icon.ico",
            "uninstallerIcon": "src/renderer/assets/icon.ico",
            "artifactName": "Shop-Ledger-PH-Setup-${version}.exe"
        }
    }
}
